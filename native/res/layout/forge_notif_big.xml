<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded: big step count + goal line, goal ring with percent, then KCAL / KM / TO GO -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fn_steps"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:text="steps"
                    android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/fn_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="12dp">

            <ProgressBar
                android:id="@+id/fn_ring"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="54dp"
                android:minHeight="54dp"
                android:progressDrawable="@drawable/forge_notif_ring" />

            <TextView
                android:id="@+id/fn_pct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textColor="@color/forge_notif_accent_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="@color/forge_notif_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fn_kcal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="KCAL"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fn_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="KM"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fn_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-condensed"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fn_left_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="TO GO"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Info"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
